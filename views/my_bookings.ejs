<%- include('partials/header') %>

    <div style="background-color: var(--primary-color); padding: 2rem 0; color: var(--white); margin-bottom: 2rem;">
        <div class="container">
            <h1>My Bookings</h1>
            <p>Manage your site visit requests</p>
        </div>
    </div>

    <div class="container" style="margin-bottom: 5rem;">
        <% if (inquiries.length> 0) { %>
            <div class="grid">
                <% inquiries.forEach(inquiry=> { %>
                    <div
                        style="background: var(--white); border-radius: 0.5rem; padding: 1.5rem; box-shadow: var(--shadow); border: 1px solid #e2e8f0;">
                        <div
                            style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;">
                            <div>
                                <span class="status-badge <%= inquiry.status.toLowerCase() %>"
                                    style="margin-bottom: 0.5rem; display: inline-block;">
                                    <%= inquiry.status %>
                                </span>
                                <h3>
                                    <%= inquiry.service_type %>
                                </h3>
                                <p style="color: #64748b; font-size: 0.9rem;"><i class="fa-solid fa-calendar"></i>
                                    <%= inquiry.createdAt.toLocaleDateString() %>
                                </p>
                            </div>
                            <% if (inquiry.status==='Pending' ) { %>
                                <div style="display: flex; gap: 0.5rem;">
                                    <a href="/my-bookings/edit/<%= inquiry._id %>"
                                        style="color: #2563eb; font-size: 1.1rem;" title="Edit"><i
                                            class="fa-solid fa-pen-to-square"></i></a>
                                    <form action="/my-bookings/delete/<%= inquiry._id %>" method="POST"
                                        style="display: inline;"
                                        onsubmit="return confirm('Are you sure you want to delete this booking?');">
                                        <button type="submit"
                                            style="background: none; border: none; color: #ef4444; font-size: 1.1rem; cursor: pointer;"
                                            title="Delete"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </div>
                                <% } %>
                        </div>
                        <div style="border-top: 1px solid #f1f5f9; padding-top: 1rem;">
                            <p><strong>City:</strong>
                                <%= inquiry.city %>
                            </p>
                            <p><strong>Message:</strong>
                                <%= inquiry.message || 'No message' %>
                            </p>
                        </div>
                    </div>
                    <% }); %>
            </div>
            <% } else { %>
                <div
                    style="text-align: center; padding: 3rem; background: var(--white); border-radius: 0.5rem; box-shadow: var(--shadow);">
                    <i class="fa-solid fa-calendar-xmark"
                        style="font-size: 3rem; color: #cbd5e1; margin-bottom: 1rem;"></i>
                    <h3>No Bookings Found</h3>
                    <p style="margin-bottom: 1.5rem; color: #64748b;">You haven't made any site visit requests yet.</p>
                    <a href="/#book" class="btn-primary">Book Now</a>
                </div>
                <% } %>
    </div>

    <%- include('partials/footer') %>