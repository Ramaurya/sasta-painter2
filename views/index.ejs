<%- include('partials/header') %>

    <section class="hero">
        <div class="container hero-content">
            <h1>Transform Your Home with Professional Painting</h1>
            <p>Premium painting services in Delhi & Noida. Expert painters, on-time delivery, and 100% satisfaction
                guaranteed.</p>
            <a href="#book" class="btn-primary">Get Free Estimate</a>
        </div>
    </section>

    <section class="features">
        <div class="container">
            <div class="section-title">
                <span>Why Choose Us</span>
                <h2>The AapkaPainter Advantage</h2>
            </div>
            <div class="grid">
                <div class="feature-card">
                    <i class="fa-solid fa-clock feature-icon"></i>
                    <h3>On-Time Completion</h3>
                    <p>We respect your time. Our dedicated team ensures timely delivery of all projects.</p>
                </div>
                <div class="feature-card">
                    <i class="fa-solid fa-user-shield feature-icon"></i>
                    <h3>Safe & Hygiene</h3>
                    <p>Our painters follow strict safety protocols and maintain hygiene throughout the process.</p>
                </div>
                <div class="feature-card">
                    <i class="fa-solid fa-medal feature-icon"></i>
                    <h3>Premium Finish</h3>
                    <p>We use top-quality paints and tools to ensure a flawless and durable finish.</p>
                </div>
            </div>
        </div>
    </section>

    <% if (services && services.length> 0) { %>
        <section class="services-preview" style="padding: 5rem 0; background-color: #f1f5f9;">
            <div class="container">
                <div class="section-title">
                    <span>Our Expertise</span>
                    <h2>Popular Services</h2>
                </div>
                <div class="grid">
                    <% services.forEach(service=> { %>
                        <div class="service-card">
                            <img src="<%= service.image %>" alt="<%= service.name %>" class="service-img">
                            <div class="service-content">
                                <h3>
                                    <%= service.name %>
                                </h3>
                                <p>
                                    <%= service.description %>
                                </p>
                                <a href="/services" style="color: var(--accent-color); font-weight: 600;">Learn More <i
                                        class="fa-solid fa-arrow-right"></i></a>
                            </div>
                        </div>
                        <% }); %>
                </div>
                <div style="text-align: center; margin-top: 3rem;">
                    <a href="/services" class="btn-primary">View All Services</a>
                </div>
            </div>
        </section>
        <% } %>

            <section id="book" class="booking-section">
                <div class="container">
                    <div class="section-title">
                        <span>Book Now</span>
                        <h2>Get a Free Site Visit</h2>
                    </div>
                    <div class="booking-form">
                        <% if (typeof req !=='undefined' && req.query.success) { %>
                            <div
                                style="background-color: #dcfce7; color: #166534; padding: 1rem; border-radius: 0.5rem; margin-bottom: 1.5rem; text-align: center;">
                                <strong>Success!</strong> Your inquiry has been received. We will contact you shortly.
                            </div>
                            <% } %>
                                <form action="/book" method="POST">
                                    <div class="form-group">
                                        <label for="name">Full Name</label>
                                        <input type="text" id="name" name="name" class="form-control" required>
                                    </div>
                                    <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 1rem;">
                                        <div class="form-group">
                                            <label for="phone">Phone Number</label>
                                            <input type="tel" id="phone" name="phone" class="form-control" required>
                                        </div>
                                        <div class="form-group">
                                            <label for="city">City</label>
                                            <select id="city" name="city" class="form-control" required>
                                                <option value="">Select City</option>
                                                <option value="Delhi">Delhi</option>
                                                <option value="Noida">Noida</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="email">Email Address</label>
                                        <input type="email" id="email" name="email" class="form-control">
                                    </div>
                                    <div class="form-group">
                                        <label for="service_type">Service Required</label>
                                        <select id="service_type" name="service_type" class="form-control" required>
                                            <option value="">Select Service</option>
                                            <option value="Interior Painting">Interior Painting</option>
                                            <option value="Exterior Painting">Exterior Painting</option>
                                            <option value="Rental Painting">Rental Painting</option>
                                            <option value="Waterproofing">Waterproofing</option>
                                            <option value="Wood Finishes">Wood Finishes</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label for="message">Message (Optional)</label>
                                        <textarea id="message" name="message" class="form-control" rows="3"></textarea>
                                    </div>
                                    <button type="submit" class="btn-primary" style="width: 100%;">Book Free
                                        Visit</button>
                                </form>
                    </div>
                </div>
            </section>

            <%- include('partials/footer') %>