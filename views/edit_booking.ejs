<%- include('partials/header') %>

    <div class="container" style="max-width: 600px; margin-top: 3rem; margin-bottom: 5rem;">
        <div class="booking-form" style="padding: 2rem;">
            <h2 style="margin-bottom: 1.5rem;">Edit Booking</h2>
            <form action="/my-bookings/edit/<%= inquiry._id %>" method="POST">
                <div class="form-group">
                    <label for="city">City</label>
                    <select id="city" name="city" class="form-control" required>
                        <option value="Delhi" <%=inquiry.city==='Delhi' ? 'selected' : '' %>>Delhi</option>
                        <option value="Noida" <%=inquiry.city==='Noida' ? 'selected' : '' %>>Noida</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="service_type">Service Required</label>
                    <select id="service_type" name="service_type" class="form-control" required>
                        <option value="Interior Painting" <%=inquiry.service_type==='Interior Painting' ? 'selected'
                            : '' %>>Interior Painting</option>
                        <option value="Exterior Painting" <%=inquiry.service_type==='Exterior Painting' ? 'selected'
                            : '' %>>Exterior Painting</option>
                        <option value="Rental Painting" <%=inquiry.service_type==='Rental Painting' ? 'selected' : '' %>
                            >Rental Painting</option>
                        <option value="Waterproofing" <%=inquiry.service_type==='Waterproofing' ? 'selected' : '' %>
                            >Waterproofing</option>
                        <option value="Wood Finishes" <%=inquiry.service_type==='Wood Finishes' ? 'selected' : '' %>
                            >Wood Finishes</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" class="form-control"
                        rows="3"><%= inquiry.message %></textarea>
                </div>
                <div style="display: flex; gap: 1rem;">
                    <button type="submit" class="btn-primary" style="flex: 1;">Update Booking</button>
                    <a href="/my-bookings"
                        style="flex: 1; text-align: center; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; color: var(--secondary-color);">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>