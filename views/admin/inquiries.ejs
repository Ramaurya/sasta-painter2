<%- include('../partials/header') %>

    <div style="background-color: var(--primary-color); padding: 2rem 0; color: var(--white); margin-bottom: 2rem;">
        <div class="container">
            <h1>Admin Dashboard</h1>
            <p>View all booking inquiries</p>
        </div>
    </div>

    <div class="container" style="margin-bottom: 5rem;">
        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>City</th>
                        <th>Service</th>
                        <th>Message</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (inquiries.length> 0) { %>
                        <% inquiries.forEach(inquiry=> { %>
                            <tr>
                                <td>
                                    <%= inquiry.createdAt.toLocaleDateString() %>
                                </td>
                                <td>
                                    <strong>
                                        <%= inquiry.name %>
                                    </strong><br>
                                    <span style="font-size: 0.8rem; color: #64748b;">
                                        <%= inquiry.email %>
                                    </span>
                                </td>
                                <td>
                                    <%= inquiry.phone %>
                                </td>
                                <td>
                                    <%= inquiry.city %>
                                </td>
                                <td>
                                    <%= inquiry.service_type %>
                                </td>
                                <td>
                                    <span class="status-badge <%= inquiry.status.toLowerCase() %>">
                                        <%= inquiry.status %>
                                    </span>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <% if (inquiry.status==='Pending' ) { %>
                                            <form action="/admin/inquiries/<%= inquiry._id %>/update" method="POST"
                                                style="display:inline;">
                                                <input type="hidden" name="status" value="Contacted">
                                                <button type="submit"
                                                    style="background: none; border: none; cursor: pointer; color: #2563eb; font-size: 1.2rem;"
                                                    title="Mark Contacted">
                                                    <i class="fa-solid fa-phone"></i>
                                                </button>
                                            </form>
                                            <% } %>
                                                <% if (inquiry.status !=='Completed' ) { %>
                                                    <form action="/admin/inquiries/<%= inquiry._id %>/update"
                                                        method="POST" style="display:inline;">
                                                        <input type="hidden" name="status" value="Completed">
                                                        <button type="submit"
                                                            style="background: none; border: none; cursor: pointer; color: #166534; font-size: 1.2rem;"
                                                            title="Mark Completed">
                                                            <i class="fa-solid fa-check"></i>
                                                        </button>
                                                    </form>
                                                    <% } %>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="7"
                                    style="padding: 0.5rem 1rem 1rem; border-bottom: 2px solid #e2e8f0; font-size: 0.9rem; color: #475569;">
                                    <strong>Message:</strong>
                                    <%= inquiry.message || 'No message' %>
                                        <% if (inquiry.editHistory && inquiry.editHistory.length> 0) { %>
                                            <div
                                                style="margin-top: 0.5rem; background: #f8fafc; padding: 0.5rem; border-radius: 0.3rem; border: 1px dashed #cbd5e1;">
                                                <strong style="color: #94a3b8; font-size: 0.8rem;">Edit
                                                    History:</strong>
                                                <ul
                                                    style="list-style: none; padding: 0; margin: 0; font-size: 0.8rem; color: #64748b;">
                                                    <% inquiry.editHistory.forEach(edit=> { %>
                                                        <li>
                                                            <span style="color: #475569;">
                                                                <%= edit.timestamp.toLocaleDateString() %>
                                                                    <%= edit.timestamp.toLocaleTimeString() %>:
                                                            </span>
                                                            <% if (edit.changes.city) { %> Prev City:
                                                                <%= edit.changes.city %>;
                                                                    <% } %>
                                                                        <% if (edit.changes.service_type) { %> Prev
                                                                            Service:
                                                                            <%= edit.changes.service_type %>;
                                                                                <% } %>
                                                                                    <% if (edit.changes.message) { %>
                                                                                        Prev Msg:
                                                                                        <%= edit.changes.message %>;
                                                                                            <% } %>
                                                        </li>
                                                        <% }); %>
                                                </ul>
                                            </div>
                                            <% } %>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" style="text-align: center;">No inquiries found.</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <%- include('../partials/footer') %>