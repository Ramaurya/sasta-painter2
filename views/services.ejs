<%- include('partials/header') %>

    <div style="background-color: var(--primary-color); padding: 4rem 0; text-align: center; color: var(--white);">
        <div class="container">
            <h1>Our Services</h1>
            <p>Comprehensive painting solutions for your home and office in Delhi & Noida.</p>
        </div>
    </div>

    <section class="services-page" style="padding: 5rem 0;">
        <div class="container">
            <div class="grid">
                <% if (services.length> 0) { %>
                    <% services.forEach(service=> { %>
                        <div class="service-card">
                            <img src="<%= service.image %>" alt="<%= service.name %>" class="service-img">
                            <div class="service-content">
                                <span
                                    style="font-size: 0.8rem; color: var(--accent-color); font-weight: 600; text-transform: uppercase;">
                                    <%= service.category %>
                                </span>
                                <h3 style="margin-top: 0.5rem;">
                                    <%= service.name %>
                                </h3>
                                <p>
                                    <%= service.description %>
                                </p>
                                <a href="/#book" class="btn-primary"
                                    style="display: inline-block; margin-top: 1rem; font-size: 0.9rem; padding: 0.5rem 1rem;">Book
                                    Now</a>
                            </div>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <p>No services found.</p>
                                <% } %>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>